<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Themed icons (Android 13+) get their own drawable rather than reusing the foreground: the
         system reads only alpha, which would flatten the sheets and the ribbon into one blob. The
         monochrome layer cuts those separations in as holes instead. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
