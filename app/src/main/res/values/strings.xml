<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: GPL-3.0-only

  Translators: see the notes on individual strings below. Anything marked
  translatable="false" is a brand name, a legal notice, or a unit symbol —
  please leave those alone.

  Format arguments are positional (%1$s, %2$d) so a translation can reorder
  them. Dates are formatted in code and arrive as text.

  A note on vocabulary: this app never says "Markdown", "frontmatter", "tag
  syntax" or "file". Its users write; they do not edit documents in a markup
  language. Say "note", "folder", "text".
-->
<resources>

    <!-- ===== Brand ===== -->

    <!-- The app's name. Not licensed for use by forks, and never translated. -->
    <string name="app_name" translatable="false">Pocket Prose</string>
    <!-- The app's one-line description, under the wordmark on the About page and as the repository's
         description. Three verbs, not a sentence about software: what the writer does, not what the
         app is. Translate it as a slogan rather than word for word — "capture inspiration" is the
         only part that has to survive intact. -->
    <string name="app_tagline">Write, keep, capture inspiration</string>

    <!-- ===== Choosing the folder ===== -->

    <!-- Shown once, before any folder has been picked. -->
    <string name="welcome_title">Your notes live in a folder</string>
    <!-- The explanation under it. Deliberately says nothing about formats or syncing. -->
    <string name="welcome_body">Point Pocket Prose at the folder your writing is already in. Nothing is copied or moved — your notes stay exactly where they are.</string>
    <!-- Button that opens the system folder picker. -->
    <string name="welcome_choose">Choose folder</string>

    <!-- Shown when a folder was chosen before but is no longer reachable — an SD card that was
         removed, or a folder that was deleted from a computer. Distinct from never having
         chosen one, which is not an error. -->
    <string name="folder_gone_title">That folder isn\'t there any more</string>
    <string name="folder_gone_body">Pocket Prose can\'t reach the folder you chose. It may have been moved, renamed, or removed with an SD card. Your notes are not affected.</string>
    <string name="folder_gone_choose">Choose another folder</string>

    <!-- ===== Library ===== -->

    <!-- Shown in a row instead of the first line of the note, when the note has no text in it
         yet. 36 of the author's own notes are a title and a tag and nothing else, so this is a
         normal state, not an error — keep it plain and unalarmed. -->
    <string name="note_empty">-</string>
    <!-- Spoken by a screen reader for the three dots that show while the folder is being read.
         Never seen: the dots carry no text. Says what is happening rather than "loading", because
         what is happening is that a folder is being looked through. -->
    <string name="library_loading">Looking through your folder</string>
    <!-- Shown when the chosen folder holds no notes at all. -->
    <string name="library_empty">No notes in this folder yet</string>
    <!-- Opens the folder picker again, to point at a different folder. -->
    <string name="action_change_folder">Change folder</string>

    <!-- ===== Editor ===== -->

    <!-- Leaves the note and goes back to the list. -->
    <string name="editor_back">Back to notes</string>
    <!-- Placeholder in an empty note. 40 of the author's notes start life like this. -->
    <string name="editor_empty">Start writing…</string>

    <!-- The bar that appears over selected text. These are verbs, not format names: the audience
         does not know what "emphasis" is and should not have to. -->
    <string name="format_bold">Bold</string>
    <string name="format_italic">Italic</string>
    <string name="format_bullet">Bullet list</string>
    <!-- The five sizes the heading menu offers, largest first. The parser understands six; the
         first is not offered, because a heading above the note's own title has nothing to head.
         Named by size rather than by number: the audience does not count heading levels. -->
    <string name="format_heading_2">Large heading</string>
    <string name="format_heading_3">Medium heading</string>
    <string name="format_heading_4">Small heading</string>
    <string name="format_heading_5">Smaller heading</string>
    <string name="format_heading_6">Smallest heading</string>
    <!-- Puts a dividing line across the page. Called what it looks like, not what it is called in
         Markdown — "horizontal rule" is a typesetter's word. -->
    <string name="format_rule">Divider</string>
    <!-- Takes the app's own marks back off the selected text. -->
    <string name="format_clear">Remove formatting</string>
    <!-- The clipboard, in the same bar. Android's own floating popup is suppressed in the editor —
         it lands on top of the line being selected — so these are the only way to reach it. -->
    <string name="format_cut">Cut</string>
    <string name="format_copy">Copy</string>
    <string name="format_paste">Paste</string>
    <!-- Ends writing: puts the keyboard away and brings the note's tags back. Pinned outside the
         scrolling part of the bar so it can never be scrolled out of reach. -->
    <string name="format_done">Stop writing</string>

    <!-- Shown instead of the editor when the app cannot reproduce a note's bytes exactly. It is
         better to refuse to edit than to risk rewriting a note wrongly — see IndexedNote.roundTrips.
         Deliberately blames the app, because it is the app's shortcoming. -->
    <string name="editor_readonly_title">This note is open for reading only</string>
    <string name="editor_readonly_body">Pocket Prose can\'t be certain it would save this note exactly as it found it, so it won\'t change it at all. You can still read it here, and edit it anywhere else.</string>

    <!-- ===== Making and removing notes ===== -->

    <!-- The button that starts a new note. -->
    <string name="new_note">New note</string>
    <!-- Title of the dialog that asks what the new note is called. -->
    <string name="new_note_title">What is it called?</string>
    <!-- Label of the field in that dialog. A note is filed under its title here, and 40 of the
         author's notes are a title and nothing else, so this is often the whole note. -->
    <string name="new_note_label">Title</string>
    <!-- Confirms the dialog and opens the new note. -->
    <string name="new_note_create">Create</string>
    <!-- Dismisses a dialog without doing anything. Shared by the new-note and delete dialogs. -->
    <string name="action_cancel">Cancel</string>

    <!-- Opens the menu in the editor's bar. -->
    <string name="editor_menu">More</string>
    <!-- The menu entry, and the confirming button in the dialog it opens. -->
    <string name="delete_note">Delete note</string>
    <!-- Title of the confirmation. Names the note so there is no doubt which one; %1$s is its title. -->
    <string name="delete_note_confirm">Delete “%1$s”?</string>
    <!-- Body of the confirmation. Says plainly what happens and that this app cannot undo it. Does
         not promise anything about the sync client, which may or may not keep a copy. -->
    <string name="delete_note_body">The note is removed from your folder. Pocket Prose cannot bring it back.</string>
    <!-- Shown when the file could not be removed. -->
    <string name="delete_failed">The note could not be deleted</string>

    <!-- ===== Tags, at the foot of a note ===== -->

    <!-- The chip row under a note. Tapping it anywhere opens the tag sheet. -->
    <string name="note_tags_edit">Edit tags</string>
    <!-- The chip that stands in for the row on a note that has no tags yet. -->
    <string name="note_tags_none">Add a tag</string>
    <!-- Title of the sheet that opens from the chip row. -->
    <string name="tag_sheet_title">Tags</string>
    <!-- Label of the field for a tag that does not exist yet. -->
    <string name="tag_sheet_new">New tag</string>
    <!-- Button beside that field. A verb: it puts the typed tag on this note. -->
    <string name="tag_sheet_add">Add</string>
    <!-- Closes the sheet and writes the change. -->
    <string name="tag_sheet_done">Done</string>

    <!-- Shown when a note changed somewhere else (a laptop, another phone) while it was open here.
         Not an error: this folder is synced, so it is an ordinary thing to happen. Never overwrite
         and never merge — keep both and let the writer decide. -->
    <string name="conflict_title">This note changed somewhere else</string>
    <string name="conflict_body">While you were writing, this note was edited on another device. Pocket Prose has not touched either version.</string>
    <!-- Writes what the user typed as a new note beside the original, keeping both. -->
    <string name="conflict_keep_both">Keep both</string>
    <!-- Throws away what the user typed here and shows the version from the other device. -->
    <string name="conflict_discard">Discard my changes</string>

    <!-- Shown briefly after something went wrong while saving. %1$s is a short reason. -->
    <string name="save_failed">Couldn\'t save: %1$s</string>
    <!-- Shown when a new note could not be made. %1$s is a lowercase fragment from CreateResult. -->
    <string name="create_failed">Couldn\'t make the note: %1$s</string>

    <!-- Spoken by a screen reader for a picture in a note that has no description of its own.
         Every image in the author's archive is a chord diagram with an empty alt text. -->
    <string name="image_untitled">Picture in this note</string>
    <!-- Shown in place of a picture whose file is not in the folder. The archive has 24 links to a
         folder the export referred to and never created; the app says so and changes nothing. -->
    <string name="image_missing">Picture not found: %1$s</string>

    <!-- Heading of the row of attached files at the foot of a note. -->
    <string name="attachments_title">Attached</string>
    <!-- Shown when an attachment cannot be opened because nothing on the phone handles it. -->
    <string name="attachment_no_app">Nothing on this phone can open that file</string>
    <!-- Shown beside an attachment whose file is missing from the folder. -->
    <string name="attachment_missing">missing</string>

    <!-- ===== Tag drawer ===== -->

    <!-- Opens the tag drawer. Spoken by a screen reader; never seen. -->
    <string name="drawer_open">Show tags</string>
    <!-- The entry above the tag tree that clears any filter. -->
    <string name="drawer_all_notes">All notes</string>
    <!-- Title over the tag tree. Says "topics" rather than "tags" nowhere on purpose: "tags" is the
         one piece of jargon the audience already knows from every other app, and inventing a
         synonym would be less clear, not more. What is hidden is the `#`, not the word. -->
    <string name="drawer_tags">Tags</string>
    <!-- Expands or collapses a tag that has sub-tags. -->
    <string name="drawer_expand">Show sub-tags</string>
    <string name="drawer_collapse">Hide sub-tags</string>

    <!-- ===== Search ===== -->

    <string name="search_open">Search</string>
    <string name="search_close">Close search</string>
    <!-- Placeholder inside the search field. -->
    <string name="search_hint">Search your notes</string>
    <!-- Shown when a search or a tag filter matches nothing. %1$s is what was typed. -->
    <string name="search_no_results">Nothing matches “%1$s”</string>
    <!-- Shown when a tag filter matches nothing, which should not happen but is cheap to survive. -->
    <string name="filter_no_results">No notes with this tag</string>
    <!-- The current filter, shown under the title in place of the folder name. %1$s is the tag. -->
    <string name="filter_showing">Filtered by %1$s</string>

    <!-- How many tags a list row could not fit. Shown as a chip after the last one that did:
         "+2". Kept as a resource rather than built in code so a translation can change the sign
         or its placement; %1$d is the number hidden. -->
    <string name="tag_overflow">+%1$d</string>
    <!-- Spoken by a screen reader in place of the "+2" chip. -->
    <plurals name="tag_overflow_description">
        <item quantity="one">%1$d more tag</item>
        <item quantity="other">%1$d more tags</item>
    </plurals>

    <!-- Number of notes in the chosen folder, shown under the title. -->
    <plurals name="note_count">
        <item quantity="one">%1$d note</item>
        <item quantity="other">%1$d notes</item>
    </plurals>

    <!-- ===== Settings ===== -->

    <!-- Title of the settings screen, and the row in the tag drawer that opens it. -->
    <string name="settings_title">Settings</string>
    <!-- Leaves the settings and goes back to the list. -->
    <string name="action_back">Back</string>

    <!-- The three tabs. "Editor" holds what happens while you are writing, "System" the app's own
         set-up; About is not a setting at all and is a tab because the tab row is the only strip
         that stays visible. -->
    <string name="settings_tab_editor">Editor</string>
    <string name="settings_tab_system">System</string>
    <string name="settings_tab_about">About</string>

    <!-- Section headings. Shown uppercased by the screen, so write them in sentence case. -->
    <string name="settings_section_writing">Writing</string>
    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_section_folder">Folder</string>
    <string name="settings_section_start">Start view</string>
    <string name="settings_section_size">Size and spacing</string>

    <!-- The faces a note can be set in. "System" is whatever the phone uses everywhere else; the
         other two are font names and are never translated. -->
    <string name="font_system">System</string>
    <string name="font_literata" translatable="false">Literata</string>
    <string name="font_eb_garamond" translatable="false">EB Garamond</string>
    <!-- Beside each name, saying what kind of face it is — the thing a font name alone does not
         tell anyone who does not already know the font. Two words the audience does meet on any
         font menu, so they earn their place where "Markdown" would not. -->
    <string name="font_kind_sans">Sans-serif</string>
    <string name="font_kind_serif">Serif</string>
    <!-- The sample line under each name, set in the face it belongs to. Not a pangram: this is
         about how a face reads, not about which letters it has, so translate it as a line someone
         might actually write. Keep it short enough for one line on a narrow phone, and keep some
         letters that go above and below — the b, the g and the capital give the face away. -->
    <string name="font_preview">Handwritten pages, quietly kept</string>
    <!-- Under the font chips. Says what the setting does and, as importantly, what it does not:
         nothing about the note on disk changes. -->
    <string name="settings_font_caption">The face your notes are shown in. Only on screen — nothing in your folder changes.</string>

    <!-- Above each row of chips in the size section, naming which of the two it sets. -->
    <string name="settings_text_size">Text size</string>
    <string name="settings_line_spacing">Line spacing</string>
    <!-- The five text sizes. Steps, not measurements: the size in points would mean nothing here,
         since each face is corrected to its own size before this multiplies it. -->
    <string name="size_small">Small</string>
    <string name="size_normal">Normal</string>
    <string name="size_large">Large</string>
    <string name="size_larger">Larger</string>
    <string name="size_largest">Largest</string>
    <!-- The three line spacings: less air between the lines, the face's own, more. -->
    <string name="leading_tight">Tight</string>
    <string name="leading_normal">Normal</string>
    <string name="leading_airy">Airy</string>
    <!-- The sample paragraph, shown at the chosen face, size and spacing. Dylan Moran, trimmed to
         start at the second sentence so the submarine — the line worth quoting — is still on screen
         at the largest size, where only three lines fit. A quotation, so it stands in the original
         in every language; the attribution beside it is not translated either. Long enough to
         overflow the box at every size, which is what keeps the fade at its foot meaningful. -->
    <string name="settings_prose_preview" translatable="false">As far as I\'m concerned, I am a writer — whether my writing\'s spoken or written in a blog, paper, book or printed on the side of a submarine.</string>
    <string name="settings_prose_preview_source" translatable="false">— Dylan Moran</string>
    <!-- Under the size and spacing chips. Same reassurance as the font caption: the file is not
         touched, and the phone's own font size still applies on top of this. -->
    <string name="settings_size_caption">How your notes are set on screen. Your phone\'s own text size still applies on top of this.</string>

    <!-- The three theme choices. "System" means whatever the phone is doing. -->
    <string name="theme_system">System</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>

    <!-- The row that chooses which tag the library opens filtered by. -->
    <string name="settings_start_tag">Open filtered by</string>
    <!-- Under that row when no tag is set, and the name of the option that clears it. -->
    <string name="settings_start_tag_all">All notes</string>
    <!-- Under the start-view row. Says what happens when the tag is gone, because that is the one
         behaviour a user cannot discover by trying it. -->
    <string name="settings_start_tag_caption">The library opens showing only this tag. If the tag is missing when the app starts, it opens showing everything.</string>

    <!-- Under the folder row, before any folder has been chosen. -->
    <string name="settings_folder_none">No folder chosen yet</string>
    <!-- Under the folder row. Repeats the promise the welcome screen makes, because this is the
         one button in the app that sounds like it might move something. -->
    <string name="settings_folder_caption">Your notes stay where they are. Pocket Prose only reads the folder you point it at.</string>

    <!-- ===== Renaming a tag ===== -->

    <!-- Title of the rename dialog. %1$s is the tag's full path, e.g. "album/debut". -->
    <string name="rename_tag_title">Rename %1$s</string>
    <string name="rename_tag_label">New name</string>
    <!-- Under the field: how much of the archive this rewrites. Children come with the tag, which is
         why this counts notes rather than naming the tag again. -->
    <plurals name="rename_tag_scope">
        <item quantity="one">Rewrites the tag in 1 note. Nested tags are renamed too.</item>
        <item quantity="other">Rewrites the tag in %1$d notes. Nested tags are renamed too.</item>
    </plurals>
    <!-- Shown instead when the new name is a tag that already exists. Its own sentence because a
         merge is the one outcome here that renaming back does not undo. %1$s is the new name. -->
    <string name="rename_tag_merges">%1$s already exists. The two tags will be merged, and renaming back will not separate them again.</string>
    <string name="rename_tag_confirm">Rename</string>
    <string name="rename_tag_confirm_merge">Merge</string>
    <!-- Spoken while a rename is writing. The drift on screen is the same one the folder is read
         with; this is the half that says which of the two is happening. -->
    <string name="rename_tag_working">Renaming the tag across your notes</string>
    <!-- Under the animation while a rename runs. Short by design: it is there to say the app is
         alive during a wait of a few seconds, not to explain itself. -->
    <string name="rename_tag_caption">Renaming…</string>

    <!-- After a rename. %1$d is the number of notes rewritten. -->
    <plurals name="rename_tag_done">
        <item quantity="one">Renamed in 1 note</item>
        <item quantity="other">Renamed in %1$d notes</item>
    </plurals>
    <!-- Nothing was written: the folder changed underneath the app, usually a sync landing. %1$s is
         one file name. The archive is untouched, which is the part worth saying. -->
    <string name="rename_tag_stale">Nothing was renamed: %1$s changed on disk. Pull to refresh and try again.</string>
    <!-- Nothing was written because a note cannot be reproduced byte for byte. %1$s is a file name. -->
    <string name="rename_tag_refused">Nothing was renamed: %1$s cannot be saved safely.</string>
    <!-- The rename stopped part way. Both numbers matter, and so does the fact that running it again
         is the fix. %1$d were written, %2$d were not. -->
    <string name="rename_tag_partial">Renamed %1$d notes, %2$d left. Try the rename again to finish.</string>

    <!-- ===== Moving tags and titles into notes ===== -->

    <!-- What this folder actually has written into its text, dropped into the sentences below. One
         of the three, chosen by the survey's counts. Lowercase and plural, because every slot that
         takes one puts it mid-sentence — a folder that only needs one half must not be told about
         the other, and "tags and titles" must not become two separate offers. -->
    <string name="move_tags_what_tags">tags</string>
    <string name="move_tags_what_titles">titles</string>
    <string name="move_tags_what_both">tags and titles</string>

    <!-- The banner above the library, for a folder written in an editor that kept a tag as a
         #hashtag and a title as a heading. Deliberately says "inside your notes" rather than naming
         the format: the people this is for write songs, not YAML. %1$s is one of the three above. -->
    <string name="move_tags_banner">Your %1$s are written inside your notes.</string>
    <string name="move_tags_banner_action">Move them</string>
    <string name="move_tags_banner_dismiss">Dismiss</string>

    <!-- The dialog the banner opens. %1$s is what is being moved. -->
    <string name="move_tags_title">Move your %1$s</string>
    <!-- The count, which is the thing that sizes the decision. %1$d notes have something written
         into the text, %2$d notes in the folder altogether, %3$s is what. -->
    <plurals name="move_tags_scope">
        <item quantity="one">1 of your %2$d notes has %3$s written into the text.</item>
        <item quantity="other">%1$d of your %2$d notes have %3$s written into the text.</item>
    </plurals>
    <!-- What the move is for. "Kept with the note" is the honest description of a tag list and a
         title the reader never sees while writing. %1$s is what is being moved. -->
    <string name="move_tags_body">Pocket Prose keeps %1$s with the note instead of in the text, so they stay out of your writing. Moving them changes those files.</string>
    <!-- Only when the tag list actually gains something. %1$d is how many tags are new. -->
    <plurals name="move_tags_gained">
        <item quantity="one">Your tag list gains 1 tag.</item>
        <item quantity="other">Your tag list gains %1$d tags.</item>
    </plurals>
    <!-- Only when notes are gaining a title. Said out loud because it is what makes the title
         editable and what stops the library falling back to the file name. %1$d is how many. -->
    <plurals name="move_tags_titled">
        <item quantity="one">1 note keeps the title it shows, as its own.</item>
        <item quantity="other">%1$d notes keep the titles they show, as their own.</item>
    </plurals>
    <string name="move_tags_confirm">Move them</string>
    <string name="move_tags_cancel">Leave them as they are</string>

    <!-- Spoken while the move is writing, in place of the folder-reading line. No noun: "them" is
         the button that was just tapped, one tap ago, and the loading line takes no arguments. -->
    <string name="move_tags_working">Moving them into your notes</string>
    <string name="move_tags_caption">Moving…</string>

    <!-- After the move. %1$d is the number of notes rewritten, %2$s is what was moved. -->
    <plurals name="move_tags_done">
        <item quantity="one">Moved the %2$s in 1 note</item>
        <item quantity="other">Moved the %2$s in %1$d notes</item>
    </plurals>
    <!-- Nothing was written: the folder changed underneath the app, usually a sync landing. %1$s is
         one file name. -->
    <string name="move_tags_stale">Nothing was moved: %1$s changed on disk. Pull to refresh and try again.</string>
    <!-- Nothing was written because a note cannot be reproduced byte for byte. %1$s is a file name.
         The note being named is the point: it is the one to go and look at. -->
    <string name="move_tags_refused">Nothing was moved: %1$s cannot be saved safely.</string>
    <!-- The move stopped part way, so the folder is in two states at once. %1$d notes were done,
         %2$d were not. -->
    <string name="move_tags_partial">Moved %1$d notes, %2$d left. Try again to finish.</string>

    <!-- The settings row that brings the offer back after it was dismissed. Shown only while there
         is still something to move. %1$s is what. -->
    <string name="settings_move_tags">Your %1$s are still in your text</string>
    <plurals name="settings_move_tags_subtitle">
        <item quantity="one">1 note has %2$s written into the text</item>
        <item quantity="other">%1$d notes have %2$s written into the text</item>
    </plurals>
    <string name="settings_move_tags_caption">Moving them puts your %1$s with the note, out of your writing and where the app can use them.</string>

    <!-- ===== About ===== -->

    <!-- The version line. %1$s is a version like "0.1 (1)". -->
    <string name="about_version">v%1$s</string>
    <!-- What a long-press on the version line puts on the clipboard, for pasting into a bug
         report. Not translated: it is an identifier. -->
    <string name="about_version_clipboard" translatable="false">Pocket Prose %1$s</string>
    <!-- Confirmation after that long-press, shown only below Android 13; newer versions show
         their own. -->
    <string name="about_version_copied">Version copied</string>

    <string name="about_section_about">About</string>
    <string name="about_body_about">I built Pocket Prose for my own lyrics, which live in a folder and are going to stay there. Maybe your writing does too.</string>
    <string name="about_section_website">Website</string>
    <string name="about_body_website">The app lives here:</string>
    <string name="about_section_bugs">Bugs</string>
    <string name="about_body_bugs">Found a hiccup? Let me know:</string>
    <string name="about_section_support">Support</string>
    <string name="about_body_support">If you can, support its development:</string>
    <string name="about_section_license">License</string>
    <!-- A legal notice, and never translated. -->
    <string name="about_copyright" translatable="false">Copyright © 2026 Kreuder</string>
    <string name="about_license" translatable="false">Pocket Prose is free software under the GPL-3.0-only. The wordmark and the icon are CC BY 4.0; the name is not licensed, so a fork needs its own. Built with AndroidX and Jetpack Compose, licensed under Apache 2.0. Sets your notes in Literata, © 2017 The Literata Project Authors, or EB Garamond, © 2017 The EB Garamond Project Authors — both under the SIL Open Font License 1.1.</string>

    <!-- ===== Support ===== -->

    <!-- Opens the support dialog, from the foot of the tag drawer. -->
    <string name="drawer_support">Support Pocket Prose</string>
    <!-- Closes a dialog. -->
    <string name="action_close">Close</string>

    <string name="support_title">Keep this app alive</string>
    <string name="support_no_tracking">This app doesn\'t track. Anything.\nThe downside is I have no idea if or how often it\'s used or downloaded.\nCould be zero, could be a secret cult following. I genuinely don\'t know.</string>
    <string name="support_question">Am I wasting my time publishing it? You tell me.</string>
    <string name="support_three_ways">There are three (maybe more) ways to keep me motivated:</string>
    <string name="support_easy_title">The easy way</string>
    <string name="support_easy_action">Give it a like</string>
    <string name="support_easy_note">Opens a page on my website with a like button. Nothing is counted until you press it — just the press and an anonymised IP.</string>
    <string name="support_nerdy_title">The nerdy way</string>
