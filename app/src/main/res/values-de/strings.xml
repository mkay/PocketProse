    <string name="support_title">Halte diese App am Leben</string>
    <string name="support_no_tracking">Diese App trackt nicht. Gar nicht.\nDer Nachteil: Ich habe keine Ahnung, ob und wie oft sie benutzt oder heruntergeladen wird.\nKönnte null sein, es könnten bereits Tattoos davon existieren. Ich weiß es nicht.</string>
    <string name="support_question">Lohnt sich der Aufwand, sie zu veröffentlichen? Sag es mir.</string>
    <string name="support_three_ways">Es gibt (mindestens) drei Wege, mich zu motivieren:</string>
    <string name="support_easy_title">Der einfache Weg</string>
    <string name="support_easy_action">App bewerten</string>
    <string name="support_easy_note">Öffnet eine Seite auf meiner Website mit einem Like-Button. Gezählt wird erst, wenn du ihn drückst — nur der Klick und eine anonymisierte IP.</string>
    <string name="support_nerdy_title">Der nerdige Weg</string>
    <string name="support_nerdy_action">GitHub Stern</string>
    <string name="support_nerdy_note">Ein Stern ist eine Zahl, die ich sehen kann, und er hilft anderen, die App zu finden.</string>
    <string name="support_generous_title">Der großzügige Weg</string>
    <string name="support_generous_action">Auf Ko-fi unterstützen</string>
    <string name="support_generous_note">Völlig freiwillig. Die App ist und bleibt kostenlos.</string>

